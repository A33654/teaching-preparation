# 域名
DOMAIN=localhost

# 后端生成邮件链接时使用的前端地址
FRONTEND_HOST=http://localhost:5173

# 环境：local / staging / production
ENVIRONMENT=local

PROJECT_NAME="教师备课系统"
STACK_NAME=full-stack-fastapi-project

# 后端 CORS 跨域配置
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"

# 安全配置
SECRET_KEY=请生成安全密钥替换此处
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=请设置密码

# 邮件配置
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请设置数据库密码

# Neo4j（知识图谱数据库）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请设置Neo4j密码
NEO4J_DATABASE=neo4j

# LangGraph Agent 配置
AGENT_MAX_ITERATIONS=8
AGENT_CHAT_TOP_K=10
# 知识图谱强制触发兜底：True=图谱意图强制预检索一次（默认）；False=完全由大模型自主决定
AGENT_FORCE_KG_TRIGGER=True

# 千问 API（主 LLM）
QWEN_API_KEY=请填入千问API密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek API（备用）
DEEPSEEK_API_KEY=请填入DeepSeek API密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

SENTRY_DSN=

# Docker 镜像配置
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
